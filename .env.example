# ===============================
# JWT CONFIG
# ===============================
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
ACCESS_TOKEN_TTL=30d
REFRESH_TOKEN_TTL=7d

# ===============================
# DATABASE
# ===============================
MONGO_URI=mongodb://localhost:27017/hiverift_CRM

# ===============================
# SYSTEM ADMIN LOGINS
# ===============================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# ===============================
# EMAIL / SMTP SETTINGS
# ===============================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=info@example.com
EMAIL_PASS=your_email_password
MAIL_FROM="HiveRift Desk <info@example.com>"
CONTACT_RECEIVER_EMAIL=info@example.com

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ===============================
# META LEAD ADS CONFIGURATION
# ===============================
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_PAGE_ID=your_meta_page_id
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token
META_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token
META_GRAPH_API_VERSION=v26.0
